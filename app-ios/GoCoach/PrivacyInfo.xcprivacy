<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  개인정보 매니페스트(백로그 #294). App Store Connect는 이유를 신고해야 하는 API를 쓰면서 이 파일이 없는 빌드를 받지 않는다(ITMS-91053).
  · 추적 없음 · 앱 코드가 모으는 데이터 없음 — 앱 자신의 코드는 네트워크로 아무것도 보내지 않는다(기기 식별자도 기기 밖으로 나가지 않는다).
    광고 SDK(Google Mobile Ads · UMP, #296)가 보내는 것과 그 SDK 코드가 쓰는 이유 API는 각 SDK가 자기 PrivacyInfo.xcprivacy에 선언한다 — 여기에 다시 적지 않는다.
    App Store Connect 라벨은 archive의 Privacy Report로 맞춘다(work/plans/APP_STORE_PRIVACY_ANSWERS.md ①).
  · UserDefaults CA92.1 — 앱 전용 저장(설정 · 진행도, `UserDefaultsKeyValueStore`). 앱 그룹 아님.
  · 파일 타임스탬프 C617.1 — 앱 컨테이너 안 파일의 크기 · 시각(KataGo의 모델 · 설정 · 로그, Kotlin/Skia 런타임의 stat 계열).
  ⚠️ 앱 자신의 코드가 시스템 부팅 시각 API(mach_absolute_time 등)를 쓰게 되면 SystemBootTime 35F9.1을 더한다(지금은 GMA만 쓰고, GMA 매니페스트가 선언한다).
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
