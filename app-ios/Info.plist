<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- 실행 화면 바탕 = 앱 바탕(밝게 #F6F1E7 · 어둡게 #1A1815 — AppColorScheme.kt · 안드로이드 colors.xml과 같은 값, 바꾸면 함께). 흰/검은 번쩍임을 막는다. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- 엔진 모델 팩(백로그 #293): Apple이 호스팅하는 관리형 Background Assets. 그룹은 두 .entitlements와 같은 값. 다른 BA 키는 두지 않는다(Apple 문서). -->
	<key>BAAppGroupID</key>
	<string>group.com.zenit9hub.ai.baduk</string>
	<key>BAHasManagedAssetPacks</key>
	<true/>
	<key>BAUsesAppleHosting</key>
	<true/>
	<!-- 광고(백로그 #296): 값은 빌드 설정(app-ios/Config/Ads*.xcconfig). ATT 창을 띄우지 않으므로 NSUserTrackingUsageDescription은 두지 않는다(U-86). -->
	<key>GADApplicationIdentifier</key>
	<string>$(GAD_APPLICATION_ID)</string>
	<key>GoCoachRewardedInterstitialAdUnitID</key>
	<string>$(GOCOACH_REWARDED_INTERSTITIAL_AD_UNIT_ID)</string>
	<key>GoCoachBannerAdUnitID</key>
	<string>$(GOCOACH_BANNER_AD_UNIT_ID)</string>
	<!-- Google의 SKAdNetwork 식별자 하나(타사 구매자 목록은 넣지 않았다 — 스레드가 정함). -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
