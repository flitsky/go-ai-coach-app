<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 런처 아이콘 배경(`drawable/ic_launcher_background_board.xml`) — 연한 나무 바둑판(사용자 2026-10-20).
         밝은 쪽 → 짙은 쪽 대각 그라데이션 · 옅은 나뭇결(알파 0x2C) · 5줄 격자(알파 0x7D). 스토어 512 아이콘
         (`app_icon_512x512_board.png`)과 같은 값이다 — 바꾸면 그쪽도 다시 그린다.
         (2026-10-20까지의 크림 단색 #F5F0E6은 홈 로고 배지와 같은 색이었다 — 아이콘만 나무로 바꿨다.) -->
    <color name="ic_launcher_wood_light">#ECD3A0</color>
    <color name="ic_launcher_wood_dark">#DEBA7C</color>
    <color name="ic_launcher_wood_grain">#2CA87434</color>
    <color name="ic_launcher_grid">#7D64461E</color>
    <!-- 앱 바탕색(`AppColorScheme.kt`의 `background`)과 **같은 값**이다. 테마의
         `android:windowBackground`가 이 색이어야 기동 순간 흰 화면이 한 번 번쩍이지 않는다
         (백로그 #125). ⚠️ API 31+의 시스템 스플래시 배경도 `windowSplashScreenBackground`를
         따로 주지 않으면 이 값을 그대로 쓴다 — 그래서 여기 한 곳만 맞추면 된다.
         ⚠️ `AppColorScheme.kt`의 값을 바꾸면 여기도 같이 바꿀 것. -->
    <color name="app_window_background">#F6F1E7</color>
</resources>
