<?xml version="1.0" encoding="utf-8"?>
<!--
  안드로이드 **자동 백업**(cloud-backup)과 **기기 간 전송**(device-transfer) 제외 규칙 —
  API 31 이상(백로그 #186). 사유와 수치는 `backup_rules.xml`의 주석에 있다.

  ⚠️ **두 갈래를 모두 적어야 한다** — `cloud-backup`만 적으면 새 폰으로 직접 옮기는
  기기 간 전송에서 94MB 모델이 그대로 따라간다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="katago" />
        <exclude domain="root" path="app_webview" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="katago" />
        <exclude domain="root" path="app_webview" />
    </device-transfer>
</data-extraction-rules>
